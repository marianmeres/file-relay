{
  "name": "@marianmeres/file-relay",
  "version": "1.6.0",
  "description": "CLI and library that relays local files (e.g. database dumps) to a remote destination, by HTTP upload or filesystem copy, with glob/regex filtering, marker-file deduplication, retries and optional email notification. Built for cron-driven offsite backups.",
  "license": "MIT",
  "author": "Marian Meres",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "bin": {
    "file-relay": "./dist/bin.js",
    "file-relay-install": "./dist/bin-install.js"
  },
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./mod": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    }
  },
  "files": [
    "dist",
    "API.md",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marianmeres/file-relay.git"
  },
  "bugs": {
    "url": "https://github.com/marianmeres/file-relay/issues"
  },
  "homepage": "https://github.com/marianmeres/file-relay#readme",
  "keywords": [
    "backup",
    "offsite",
    "relay",
    "upload",
    "cron",
    "cli"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "test:deno": "CLI_RUNTIME=deno deno test -A --no-lock --config jsr.json tests/",
    "smoke": "pnpm run build && node scripts/smoke-npm.ts",
    "jsr:check": "deno publish --dry-run --allow-dirty --set-version \"$npm_package_version\"",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run smoke",
    "prepublishOnly": "pnpm run ci && pnpm run build",
    "example": "node --env-file=example/.env example/file-relay-example.ts",
    "release": "npx --yes @marianmeres/release@^2.3.0 --before-commit \"node scripts/sync-version.ts\"",
    "publish:jsr": "pnpm run test:deno && deno publish --set-version \"$npm_package_version\"",
    "publish:all": "pnpm publish && pnpm run publish:jsr",
    "rp": "pnpm run release -y && pnpm run publish:all",
    "rpm": "pnpm run release minor -y && pnpm run publish:all"
  },
  "dependencies": {
    "@marianmeres/clog": "^3.21.0",
    "@marianmeres/parse-boolean": "^2.1.0",
    "@marianmeres/send-email": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
