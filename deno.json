{
  "name": "@marianmeres/file-relay",
  "version": "1.3.0",
  "exports": {
    ".": "./src/cli.ts",
    "./mod": "./src/mod.ts",
    "./install": "./src/install.ts"
  },
  "tasks": {
    "example": "deno run -A --env-file=example/.env example/file-relay-example.ts",
    "test": "deno test -A",
    "test:watch": "deno test -A --watch",
    "release": "deno run -A jsr:@marianmeres/deno-release",
    "publish": "deno publish",
    "rp": "deno task release -y && deno task publish",
    "rpm": "deno task release minor -y && deno task publish"
  },
  "imports": {
    "@marianmeres/clog": "jsr:@marianmeres/clog@^3.21.0",
    "@marianmeres/npmbuild": "jsr:@marianmeres/npmbuild@^1.16.0",
    "@marianmeres/send-email": "jsr:@marianmeres/send-email@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.5"
  },
  "fmt": {
    "useTabs": true,
    "lineWidth": 90,
    "indentWidth": 4,
    "proseWrap": "preserve"
  }
}
